bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.1")

# Configure the hermetic toolchain (Clang-based via Zig)
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

# Register toolchains for aarch64 target (hermetic)
register_toolchains(
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
)

# For Bzlmod (MODULE.bazel)
bazel_dep(name = "abseil-cpp", version = "20240116.2")
bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
)

# Add this to your MODULE.bazel
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# Register the local toolchain so it can be used for x86_64
register_toolchains("@local_config_cc//:all")
