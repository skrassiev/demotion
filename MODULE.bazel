module(name = "demotion", version = "1.0")

# 1. Import the rule
git_repo = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.1")

# Configure the hermetic toolchain (Clang-based via Zig)
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

# Register toolchains for aarch64 target (hermetic)
register_toolchains(
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
)

# For Bzlmod (MODULE.bazel)
bazel_dep(name = "abseil-cpp", version = "20260107.1")
bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "boost.property_tree", version = "1.83.0")
bazel_dep(name = "boost.algorithm", version = "1.83.0")
bazel_dep(name = "boost.program_options", version = "1.83.0")
bazel_dep(name = "boost.system", version = "1.83.0")
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/mikael-s-persson/bazel-compile-commands-extractor.git",
    commit = "02d15621b528efd877f5d5657c4b738523a0eb17",
)

# Add this to your MODULE.bazel
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# Register the local toolchain so it can be used for x86_64
register_toolchains("@local_config_cc//:all")

# Import the git repository rule

use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

# libcamera_apps shim
git_repo(
    name = "libcamera_apps",
    remote = "https://github.com/raspberrypi/libcamera-apps.git",
    commit = "2ebb5820566f2efa64d812c6fbceac94d5799f86",
    build_file_content = """
cc_library(
    name = "post_processing_plugin_hdrs",
    hdrs = glob([
        "core/*.hpp",
        "api/**/*.hpp",
        "post_processing_stages/**/*.hpp",
        "post_processing_stages/**/*.h",
    ]),
    includes = [".", "core", "api"],
    deps = [
        "@boost.property_tree",
        "@boost.algorithm",
        "@boost.program_options",
        "@boost.system",
    ],
    visibility = ["//visibility:public"],
)
""",
)
